# Copy values into .env as DATABASE_URL when using Docker Compose Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/cleaning_services?schema=public"

# App/Auth
# Local dev: http://localhost:3000
# Production: MUST be your public site URL (e.g. https://yourdomain.com) or sign-in can redirect to localhost
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Stripe (official)
STRIPE_SECRET_KEY="sk_test_xxx"

# PayPal (official)
PAYPAL_SANDBOX="true"
PAYPAL_CLIENT_ID="paypal-client-id"
PAYPAL_CLIENT_SECRET="paypal-client-secret"
